{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "schedule": ["every weekend"],
  "dependencyDashboard": true,
  "git-submodules": {
    "enabled": true
  },
  "helm-values": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "One PR per component submodule update, no automerge",
      "matchManagers": ["git-submodules"],
      "automerge": false,
      "addLabels": ["component-update"]
    },
    {
      "description": "Components in patch state (tracking a fork). Renovate is disabled for these; watch-upstream.yml detects when the fix lands upstream. Add the submodule path (e.g. 'components/nico') when entering patch state; remove it when the patch is resolved.",
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["components/infra-controller", "components/nv-rms"],
      "enabled": false
    },
    {
      "description": "Automerge GitHub Actions patch/minor updates",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["ci"]
    },
    {
      "description": "Helm chart dependency updates",
      "matchManagers": ["helm-values"],
      "automerge": false,
      "addLabels": ["helm"]
    }
  ]
}

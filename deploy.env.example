#
# Copy to deploy.env and replace the documentation-only values. Variables can
# also be passed directly to make for one-off deployments.

# Active site for single-site deployment. Site-suffixed variables below use the
# uppercase site name, for example DATAPLANE_VIP_SITE1.
SITE=site1

# Set to dpf when OpenShift DPF already owns the MetalLB operator and singleton
# MetalLB operand. Leave unset for a NICo-only management cluster.
# METALLB_MODE=dpf

# Optional list used by make deploy-all-sites.
SITES=

DATAPLANE_VIP_SITE1=192.0.2.100
DATAPLANE_POOL_SITE1=192.0.2.100-192.0.2.110
DATAPLANE_NIC_SITE1=ens1f0
DATAPLANE_NODE_IP_SITE1=192.0.2.2

# Additional sites follow the same pattern:
# DATAPLANE_VIP_SITE2=192.0.3.100
# DATAPLANE_POOL_SITE2=192.0.3.100-192.0.3.110
# DATAPLANE_NIC_SITE2=ens1f0
# DATAPLANE_NODE_IP_SITE2=192.0.3.2

SITE_NAME=
SITE_DESCRIPTION=Managed by Red Hat DSX AI Factory
